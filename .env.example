# Copy to .env for the production Docker/Compose deploy (see docs/gcp-deployment.md).
# docker compose auto-loads this file from the project root.

# Your domain or the <ip-with-dashes>.sslip.io host. Used by Caddy for TLS AND
# passed to the app as NG_ALLOWED_HOSTS (Angular's SSRF Host-header guard).
SITE_ADDRESS=34-123-45-67.sslip.io

# Optional — enables tier-1 streamed Gemini recommendations. Without it the app
# falls back to the local EmbeddingGemma tier, then to a keyword recommender.
GEMINI_API_KEY=

# Set to 1 on low-RAM hosts (e.g. e2-small) to skip loading the local
# EmbeddingGemma model. Combine with GEMINI_API_KEY to still get great AI recs
# from Gemini while keeping the runtime memory footprint small.
DISABLE_SEMANTIC=
